# Copy to devops/.env and fill in. docker compose reads it automatically.

# ---- Email OTP (login codes) ----
# Development (Mailtrap / Mailjet sandbox SMTP). Leave SMTP_HOST empty to have
# the server log codes instead of emailing them.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-pass
SMTP_FROM=no-reply@surface.local
SMTP_TLS=starttls

# Production (ProtonMail via Proton Mail Bridge running on the host):
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_USERNAME=<bridge username>
#   SMTP_PASSWORD=<bridge password>
#   SMTP_FROM=you@proton.me
#   SMTP_TLS=starttls
#   COOKIE_SECURE=true

# ---- Optional scan tuning (see README) ----
# IPINFO_TOKEN=
# PORT_SCAN_TYPE=connect
